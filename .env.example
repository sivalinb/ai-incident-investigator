# OI_ADVISOR_MODE=live
# GUARDIAN_MODEL=your-available-model
# OPENAI_API_KEY=
# OI_INPUT_USD_PER_MILLION=your-current-input-rate
# OI_OUTPUT_USD_PER_MILLION=your-current-output-rate
