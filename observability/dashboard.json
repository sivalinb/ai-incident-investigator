  "panels": [
    {
      "id": 1,
      "title": "Read the investigation, then inspect its execution",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**AI INCIDENT INVESTIGATOR** \u00b7 Real Grafana / Prometheus / OpenInference. Synthetic checkout workload.\n\n[Open Gradio review](http://127.0.0.1:7868) \u00b7 [Inspect Phoenix spans](http://127.0.0.1:6008) \u00b7 [Checkout contract](http://127.0.0.1:3015/d/guardian-checkout)\n\nOperation durations are measured. Authored fixtures never emit LLM tokens. Local inference cost is **unmeasured**; token usage is not a dollar estimate."
      }
    },
    {
      "id": 2,
      "title": "Healthy contracts",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "guardian-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(oi_panel_contexts{state=~\"healthy|expected_empty\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "guardian-prometheus"
          },
          "legendFormat": "{{operation}}{{direction}}{{mode}}{{state}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
