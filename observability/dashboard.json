      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,operation) (rate(oi_operation_duration_seconds_bucket{operation=~\"investigate|advisor.ollama|approve|grafana.screenshot\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "guardian-prometheus"
