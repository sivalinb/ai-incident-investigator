    {
      "id": 6,
      "title": "Investigation duration \u00b7 p95",
      "description": "Estimated from histogram buckets. Includes screenshot and verification time. No synthetic latency is inserted.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "guardian-prometheus"
